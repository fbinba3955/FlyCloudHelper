# FlyCloudHelper 对外端口；容器内部固定由 API 监听 9934。
FLYCLOUDHELPER_HOST_PORT=9934
FLYCLOUDHELPER_API_HOST=0.0.0.0
FLYCLOUDHELPER_API_PORT=9934
# Docker/NAS 持久化目录的运行用户；默认兼容官方 Node 镜像。
FLYCLOUDHELPER_PUID=1000
FLYCLOUDHELPER_PGID=1000
# 可选的 Jellyfin 对外地址覆盖值；不填时直接使用客户端访问的云助手 API 地址。
# 仅在反向代理、HTTPS 域名或外部端口不一致时配置；环境变量优先级最高，并锁定控制台编辑。
FLYCLOUDHELPER_PUBLIC_BASE_URL=

# 数据库：默认 SQLite。切换 postgres/mysql 后可分别填写地址、端口、库名、用户和密码。
FLYCLOUDHELPER_DATABASE_TYPE=sqlite
FLYCLOUDHELPER_SQLITE_PATH=/data/database/flycloud-helper.db
# FLYCLOUDHELPER_DATABASE_HOST=postgres
# FLYCLOUDHELPER_DATABASE_PORT=5432
# FLYCLOUDHELPER_DATABASE_NAME=flycloud_helper
# FLYCLOUDHELPER_DATABASE_USER=flymby
# FLYCLOUDHELPER_DATABASE_PASSWORD=change-me
# FLYCLOUDHELPER_DATABASE_PASSWORD_FILE=/run/secrets/flycloud_helper_database_password
# 数据库不存在时使用上述账号尝试创建；PostgreSQL 需要 CREATEDB，MySQL 需要 CREATE 权限。
FLYCLOUDHELPER_DATABASE_AUTO_CREATE=true
# 完整连接 URL 继续兼容；一旦配置，优先于上面的拆分字段。
# FLYCLOUDHELPER_DATABASE_URL=postgresql://flymby:change-me@postgres:5432/flycloud_helper
# FLYCLOUDHELPER_DATABASE_URL=mysql://flymby:change-me@mysql:3306/flycloud_helper
# FLYCLOUDHELPER_DATABASE_URL_FILE=/run/secrets/flycloud_helper_database_url

# 默认留空：首次启动自动生成 32 字节随机主密钥并保存到持久卷，创建管理员后页面会要求备份。
FLYCLOUDHELPER_CREDENTIAL_MASTER_KEY=
# FLYCLOUDHELPER_CREDENTIAL_MASTER_KEY_FILE=/run/secrets/flycloud_helper_credential_master_key
# FLYCLOUDHELPER_GENERATED_CREDENTIAL_KEY_PATH=/data/secrets/credential-master-key

# TMDB Key 在超级管理员“系统配置”页面中加密保存；这里只保留并发运行参数。
FLYCLOUDHELPER_TMDB_PER_KEY_CONCURRENCY=1
FLYCLOUDHELPER_TMDB_MAX_CONCURRENCY=32

# 音乐刮削与可选声纹配置。
FLYCLOUDHELPER_MUSICBRAINZ_USER_AGENT=FlyCloudHelper/0.1.4 (self-hosted)
FLYCLOUDHELPER_ACOUSTID_API_KEY=
# FLYCLOUDHELPER_ACOUSTID_API_KEY_FILE=/run/secrets/flycloud_helper_acoustid_key
FLYCLOUDHELPER_FPCALC_PATH=

# Web/APP 会话。
FLYCLOUDHELPER_WEB_SESSION_TTL_SECONDS=2592000
FLYCLOUDHELPER_ACCESS_TOKEN_TTL_SECONDS=3600
FLYCLOUDHELPER_REFRESH_TOKEN_TTL_SECONDS=2592000
# 只有通过 HTTPS 访问时设为 true；本机 HTTP 调试保持 false。
FLYCLOUDHELPER_COOKIE_SECURE=false

# 可选：配置后，APP 注册必须携带由受信任账号服务签发的短期华为账号绑定凭证。
# 当前仅有客户端摘要的开发环境可留空；正式开放注册时建议配置并接入签发端。
FLYCLOUDHELPER_HUAWEI_BINDING_PROOF_SECRET=
# FLYCLOUDHELPER_HUAWEI_BINDING_PROOF_SECRET_FILE=/run/secrets/flycloud_helper_huawei_binding_proof_secret

# 内置扫描 Worker。
FLYCLOUDHELPER_WORKER_ENABLED=true
FLYCLOUDHELPER_WORKER_CONCURRENCY=5
FLYCLOUDHELPER_WORKER_POLL_INTERVAL_MS=1000

# 媒体规格分析使用独立低并发队列；Docker 镜像已内置 ffprobe，无需宿主机安装。
FLYCLOUDHELPER_FFPROBE_PATH=/usr/bin/ffprobe
FLYCLOUDHELPER_MEDIA_PROBE_CONCURRENCY=1
FLYCLOUDHELPER_MEDIA_PROBE_POLL_INTERVAL_MS=2000
FLYCLOUDHELPER_FFPROBE_TIMEOUT_MS=60000
FLYCLOUDHELPER_FFPROBE_ANALYZE_DURATION_US=10000000
FLYCLOUDHELPER_FFPROBE_PROBE_SIZE_BYTES=10485760

# 容器持久化目录，通常不需要修改。
FLYCLOUDHELPER_PLUGIN_DIR=/data/plugins
FLYCLOUDHELPER_EXPORT_DIR=/data/exports
FLYCLOUDHELPER_MIGRATION_DIR=/data/migrations
FLYCLOUDHELPER_WEB_DIST_DIR=/app/web/dist
FLYCLOUDHELPER_PLUGIN_MAX_BYTES=10485760
FLYCLOUDHELPER_PLUGIN_MAX_FILES=100

# 默认允许 Provider 使用 HTTP；如需强制 HTTPS，可把 FLYCLOUDHELPER_ALLOW_INSECURE_HTTP 改为 false。
# Provider 地址不限制公网、内网、回环或保留网段。
FLYCLOUDHELPER_ALLOW_INSECURE_HTTP=true
